# Caddyfile.tk-cloudflared — fallback when .tk LE fails or port 80 blocked
# Use this if harvestfamily.tk + Freenom + LE untrusted or VPS behind NAT.
# Architecture: Cloudflare Tunnel (cloudflared --profile tunnel) terminates TLS at CF edge.
# Caddy then serves plain HTTP :80 internally; CF -> cloudflared -> caddy:80 -> api/minio/dist
#
# Steps:
# 1. Cloudflare dashboard -> Zero Trust -> Access -> Tunnels -> Create tunnel -> copy TUNNEL_TOKEN
# 2. DNS: api.harvestfamily.tk CNAME <tunnel-id>.cfargotunnel.com, media..., apex...
# 3. Tunnel config.yml (managed in CF dashboard, no local file needed with token mode):
#      ingress:
#        - hostname: harvestfamily.tk
#          service: http://caddy:80
#        - hostname: api.harvestfamily.tk
#          service: http://caddy:80
#        - hostname: media.harvestfamily.tk
#          service: http://caddy:80
#        - service: http_status:404
# 4. docker compose --profile tunnel up -d cloudflared
# 5. Caddyfile below listens :80 only (no ACME) since CF handles TLS.
#
# To use: cp Caddyfile.tk-cloudflared Caddyfile && docker compose restart caddy

{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode gzip

	handle /health* { reverse_proxy api:3000 }
	handle /api/* { reverse_proxy api:3000 }
	handle /socket.io/* { reverse_proxy api:3000 }

	# media path fallback if using single domain instead of media.* subdomain via tunnel:
	# CF route media.harvestfamily.tk -> caddy:80 -> reverse_proxy minio
	@host_media header_regexp host Host media\..*
	handle @host_media { reverse_proxy minio:9000 }
	@host_api header_regexp host Host api\..*
	handle @host_api { reverse_proxy api:3000 }

	handle {
		try_files {path} /index.html
		file_server
	}
	log { output stdout; level WARN }
}
