DOMAIN=harvestfamily.or.ke
NODE_ENV=production
# Netlify Database provisions the Postgres connection for the site.
# NETLIFY_DB_URL is normally injected by Netlify; do not hard-code it in the repo.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
JWT_SECRET=replace-with-at-least-32-random-characters
# HMAC secret for signed media URLs (<img>/<video> cannot send bearer tokens).
# Falls back to JWT_SECRET if unset; rotate independently to invalidate old media links.
MEDIA_URL_SECRET=
CORS_ORIGINS=https://harvestfamily.or.ke
# bcrypt hashes only. Generate a hash locally; never put the plaintext PIN here.
# Bootstrap only: admins with a pin_hash always authenticate against it (see app.js login).
ADMIN_PIN_HASHES='["$2b$12$replace-with-real-bcrypt-hash"]'
TRUST_PROXY=true

# External service integrations used by church features, not application hosting.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://harvestfamily.or.ke/api/giving/mpesa/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
