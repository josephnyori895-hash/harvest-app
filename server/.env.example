DOMAIN=harvestfamily.or.ke
# Production secrets: do not reuse these examples; generate unique values.
POSTGRES_PASSWORD=replace-with-long-random-password
MINIO_ACCESS_KEY=replace-with-unique-access-key
MINIO_SECRET_KEY=replace-with-long-random-secret
MINIO_BUCKET=harvest-media
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
DATABASE_URL=postgres://harvest:replace-with-postgres-password@postgres:5432/harvest
DATABASE_SSL=false
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://harvestfamily.or.ke
# bcrypt hashes only. Generate a hash locally; never put the plaintext PIN here.
ADMIN_PIN_HASHES='["$2b$12$replace-with-real-bcrypt-hash"]'
REDIS_PASSWORD=replace-with-long-random-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
TRUST_PROXY=true
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://harvestfamily.or.ke/api/giving/mpesa/callback
COTURN_HOST=harvestfamily.or.ke
COTURN_EXTERNAL_IP=AUTO
COTURN_PASSWORD=replace-with-long-random-secret
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=harvest-media
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_DIR=./backups
PORT=3000
TUNNEL_TOKEN=
