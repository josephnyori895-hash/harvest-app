DOMAIN=harvestfamily.or.ke
# for free .tk: DOMAIN=harvestfamily.tk + see Caddyfile.tk-cloudflared / --profile tunnel
TUNNEL_TOKEN=
# MinIO — required; do not use the old demo defaults
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-32chars-min-16
MINIO_BUCKET=harvest-media
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Postgres
DATABASE_URL=postgres://harvest:change-me-32chars-min-16@postgres:5432/harvest
# Auth — required in production; generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-64chars-random-openssl-hex-32
# Socket.IO browser origins — comma-separated exact origins
APP_ORIGINS=https://harvestfamily.or.ke
# PIN bcrypt kept: JSON array of hashes
ADMIN_PIN_HASHES=
# Coturn
COTURN_HOST=harvestfamily.or.ke
COTURN_EXTERNAL_IP=AUTO
COTURN_PASSWORD=change-me-coturn-32chars
# Redis
REDIS_URL=redis://redis:6379
# Backups — R2 offsite mirror
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=harvest-media
# Monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_DIR=./backups
PORT=3000
