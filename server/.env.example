DOMAIN=harvestfamily.or.ke
# for free .tk: DOMAIN=harvestfamily.tk + see Caddyfile.tk-cloudflared / --profile tunnel
TUNNEL_TOKEN=
# MinIO
MINIO_ACCESS_KEY=harvest
MINIO_SECRET_KEY=change-me-32chars-min-16
MINIO_BUCKET=harvest-media
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Postgres (aligned with MINIO_SECRET_KEY for single-secret VPS)
DATABASE_URL=postgres://harvest:change-me-32chars-min-16@postgres:5432/harvest
# Auth
JWT_SECRET=change-me-jwt-64chars-random-openssl-hex-32
# PIN bcrypt kept: JSON array of hashes; fallback 7777/0000/7C3AED if empty
ADMIN_PIN_HASHES=
# Coturn
COTURN_HOST=harvestfamily.or.ke
COTURN_EXTERNAL_IP=AUTO
COTURN_PASSWORD=change-me-coturn-32chars
# Redis
REDIS_URL=redis://redis:6379
# Backups — R2 offsite mirror (free 10GB -> we budget 1GB)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=harvest-media
# Monitoring — existing 4 daemon Telegram bot (reuse same bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_DIR=./backups
PORT=3000
