DOMAIN=harvestfamily.or.ke
# for free .tk: DOMAIN=harvestfamily.tk + see Caddyfile.tk-cloudflared / --profile tunnel
TUNNEL_TOKEN=
# MinIO
MINIO_ACCESS_KEY=harvest
MINIO_SECRET_KEY=change-me-32chars-min-16
MINIO_BUCKET=harvest-media
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Postgres (aligned with MINIO_SECRET_KEY for single-secret VPS)
DATABASE_URL=postgres://harvest:change-me-32chars-min-16@postgres:5432/harvest
# Auth — REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-64chars-random-openssl-hex-32
# Comma-separated production frontend origins, e.g. https://harvestfamily.or.ke
CORS_ORIGINS=https://harvestfamily.or.ke
# bcrypt hashes only; production refuses plaintext/default admin credentials
ADMIN_PIN_HASHES='["$2a$10$..."]'
# M-Pesa Daraja STK Push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS endpoint ending in /api/giving/mpesa/callback
MPESA_CALLBACK_URL=https://harvestfamily.or.ke/api/giving/mpesa/callback
# Coturn
COTURN_HOST=harvestfamily.or.ke
COTURN_EXTERNAL_IP=AUTO
COTURN_PASSWORD=change-me-coturn-32chars
# Redis
REDIS_URL=redis://redis:6379
# Backups — R2 offsite mirror (free 10GB -> we budget 1GB)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=harvest-media
# Monitoring — existing 4 daemon Telegram bot (reuse same bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_DIR=./backups
PORT=3000
