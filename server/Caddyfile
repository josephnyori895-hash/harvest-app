# Caddyfile — Harvest Family VPS-only (KES 1k) — Caddy 2 + Let's Encrypt
# Domain via $DOMAIN env (Caddy {$DOMAIN} expansion). Default: harvestfamily.or.ke
# Free domain .tk: see Caddyfile.tk-tunnel or use this same file + Cloudflare DNS A -> VPS IP
# TLS: Caddy auto ACME (Let's Encrypt). If 80 blocked or .tk LE fails, use --profile tunnel (cloudflared)
#
# Architecture:
#   apex ($DOMAIN)       -> /srv (vite dist) SPA + /api/* -> api:3000
#   api.$DOMAIN          -> api:3000
#   media.$DOMAIN        -> minio:9000  (S3 API + presigned GETs) + /health
#   console on :9001 localhost only (not proxied)
#
# Usage on VPS:
#   DOMAIN=harvestfamily.or.ke docker compose up -d caddy
#   # or .tk free: DOMAIN=harvestfamily.tk docker compose up -d

{
	admin off
	email admin@{$DOMAIN:harvestfamily.or.ke}
	# global: small VPS — limit logs
	log {
		output stdout
		level WARN
	}
}

# --- APEX: SPA dist + /api proxy ---
{$DOMAIN:harvestfamily.or.ke} {
	root * /srv
	encode gzip

	# health passthrough for monitoring (Telegram 4 daemons)
	handle /health* {
		reverse_proxy api:3000
	}

	# API under apex /api/* (alternative to api subdomain — convenient for single domain .tk)
	handle /api/* {
		reverse_proxy api:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# socket.io websockets
	handle /socket.io/* {
		reverse_proxy api:3000
	}

	# SPA fallback — must be last
	handle {
		try_files {path} /index.html
		file_server
		header Cache-Control "public, max-age=31536000, immutable" {
			# assets are hashed by vite
			defer
		}
		# index.html no-cache
		header /*.html Cache-Control "public, max-age=0, must-revalidate"
	}

	# security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self)"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	log {
		output stdout
		level WARN
	}
}

# --- API subdomain ---
api.{$DOMAIN:harvestfamily.or.ke} {
	encode gzip
	reverse_proxy api:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	log { output stdout; level WARN }
}

# --- MEDIA subdomain -> MinIO S3 ---
media.{$DOMAIN:harvestfamily.or.ke} {
	encode gzip
	# MinIO S3 API — presigned POST/GET via SDK, bucket harvest-media
	reverse_proxy minio:9000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		# minio needs Host preserved for signature v4
	}
	# large uploads — increase timeouts
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# CORS for direct browser POST to media subdomain
		Access-Control-Allow-Origin "https://{$DOMAIN:harvestfamily.or.ke}"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, x-amz-*"
	}
	@options method OPTIONS
	respond @options 204

	log { output stdout; level WARN }
}

# --- www redirect -> apex ---
www.{$DOMAIN:harvestfamily.or.ke} {
	redir https://{$DOMAIN:harvestfamily.or.ke}{uri} permanent
}

# --- Fallback for bare IP / direct :80 health check ---
:80 {
	respond /health "ok" 200
}
