# Harvest Family Church Nyeri — frontend environment template
# Production backend is Cloudflare Workers: https://harvestfamily-api.<subdomain>.workers.dev
# Never commit real secrets.

# ── Frontend (Vite) ──
# Leave empty for same-origin API calls in production.
# APK/Workers deployment: set to the Workers origin, e.g. https://harvestfamily-api.<subdomain>.workers.dev
VITE_API_URL=
# Realtime (Durable Object WebSocket). Empty = disabled; REST polling fallbacks are used.
VITE_REALTIME_URL=
# Production defaults to the real API unless explicitly set to false.
VITE_USE_API=true
# Development-only demo account switcher. Keep false/unset in production.
VITE_ENABLE_DEMO_ACCOUNTS=false
# Optional TURN configuration for WebRTC.
VITE_COTURN_HOST=harvestfamily.or.ke
VITE_COTURN_USER=harvest
VITE_COTURN_PASS=replace-me-32chars-min-16
# Optional: Sentry / analytics
VITE_SENTRY_DSN=

# ── Backend (Cloudflare Workers) ──
# Secrets live in wrangler: `npx wrangler secret put JWT_SECRET` etc. (see workers/README.md)
# D1 database + R2 bucket are bound in workers/wrangler.toml.
VITE_PUBLIC_APP_URL=https://harvestfamily-api.harvestfamily.workers.dev
