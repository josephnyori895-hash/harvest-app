# Harvest Family Church Nyeri — frontend environment template
# Production uses the same-origin Netlify /api rewrite. Never commit real secrets.

# ── Frontend (Vite) ──
# Leave empty for same-origin API calls in production.
VITE_API_URL=
# Production defaults to the real API unless explicitly set to false.
VITE_USE_API=true
# Development-only demo account switcher. Keep false/unset in production.
VITE_ENABLE_DEMO_ACCOUNTS=false
# Optional TURN configuration for WebRTC.
VITE_COTURN_HOST=harvestfamily.or.ke
VITE_COTURN_USER=harvest
VITE_COTURN_PASS=replace-me-32chars-min-16
# Optional: Sentry / analytics
VITE_SENTRY_DSN=

# ── Backend (server/.env / Netlify environment) ──
# See server/.env.example for the complete backend configuration.
# NETLIFY_DB_URL is injected by the Netlify Database integration; do not hard-code it.
# JWT_SECRET=replace-with-a-long-random-secret
# ADMIN_PIN_HASHES='["$2b$12$..."]'  # bcrypt hashes only, never plaintext
# CORS_ORIGINS=https://harvestfamily.or.ke,https://spiffy-frangipane-6bda1c.netlify.app
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://harvestfamily.or.ke/api/giving/mpesa/callback
