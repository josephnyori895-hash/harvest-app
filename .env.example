# Harvest Family Church — environment template
# Never commit a real .env file. Copy these variables into the environment that runs each service.

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Public API base URL. Only expose non-secret configuration through VITE_*.
VITE_API_URL=http://localhost:3000
# true = use the backend API; false = keep the local/demo adapter enabled.
VITE_USE_API=false
# Optional public monitoring DSN. Do not put secrets/tokens in VITE_* variables.
VITE_SENTRY_DSN=

# ── Backend (server/.env) ───────────────────────────────────────────────────
# Keep backend-only secrets out of the frontend bundle.
# See server/.env.example for the complete backend configuration.
# DOMAIN=harvestfamily.or.ke
# DATABASE_URL=postgres://harvest:<strong-password>@postgres:5432/harvest
# JWT_SECRET=<at-least-32-character-random-secret>
# ADMIN_PIN_HASHES='["<bcrypt-hash>"]'
# APP_ORIGINS=https://harvestfamily.or.ke
# COTURN_HOST=harvestfamily.or.ke
# COTURN_PASSWORD=<strong-secret>
# MINIO_ACCESS_KEY=<secret>
# MINIO_SECRET_KEY=<strong-secret>
# R2_ACCESS_KEY=<secret>
# R2_SECRET_KEY=<secret>
# TELEGRAM_BOT_TOKEN=<secret>
