# Harvest Family Church Nyeri — Frontend + Backend env template
# Copy to .env (root) and server/.env, fill secrets before `npm run dev` / `docker compose up`

# ── Frontend (Vite) — copy to root .env ──
# API base: leave empty for localStorage-only fallback, or set to backend URL
VITE_API_URL=http://localhost:3000
# Feature-flag: 'true' = use real backend (presign → MinIO → confirm), 'false' = localStorage picsum fallback
VITE_USE_API=false
# Coturn TURN for WebRTC (Nyeri 3G symmetric NAT) — overridden by server COTURN_* in prod
VITE_COTURN_HOST=harvestfamily.or.ke
VITE_COTURN_USER=harvest
VITE_COTURN_PASS=replace-me-32chars-min-16
# Optional: Sentry / analytics
VITE_SENTRY_DSN=

# ── Backend (server/.env) — see server/.env.example for full list ──
# DOMAIN=harvestfamily.or.ke
# TUNNEL_TOKEN=   # Cloudflare Tunnel token for free .tk (optional)
# DATABASE_URL=postgres://harvest:change-me-32chars-min-16@postgres:5432/harvest
# JWT_SECRET=change-me-jwt-64chars-random-openssl-hex-32
# ADMIN_PIN_HASHES='["$2a$10$...","$2a$10$..."]'  # bcrypt hashes, NOT plaintext
# COTURN_HOST=harvestfamily.or.ke
# COTURN_EXTERNAL_IP=AUTO
# COTURN_PASSWORD=change-me-coturn-32chars
# MINIO_* / R2_* / TELEGRAM_* / REDIS_URL — see server/.env.example
